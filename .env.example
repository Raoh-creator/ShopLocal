# --- Environment configuration ---
# Copy this file to .env and fill in real values.
DEBUG=True
SECRET_KEY=django-insecure-change-me

# Gmail SMTP (used by the Contact page)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=onlinedusbin@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Fallback recipient for the contact form (usually the shop owner)
CONTACT_EMAIL=onlinedusbin@gmail.com

# WhatsApp direct chat (without country code +, digits only, e.g. 14155552671)
WHATSAPP_NUMBER=8837351115

# Phone number for the tap-to-call button (optional, defaults to WHATSAPP_NUMBER)
PHONE_NUMBER=8837351115

# Seed values for Dashboard > Contact Settings. Only used on a fresh install;
# after the owner saves that page, the dashboard values are what the site shows.
SHOP_ADDRESS=Taphou Onaeme, Senapati
SHOP_HOURS=Mon - Sat: 9:00 AM - 8:00 PM

# Shop display name shown across the site
SHOP_NAME=LocalShop